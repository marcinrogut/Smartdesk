# Environment files - keep .env.example committed, never the real config
/.env
/.env.local
/.env.*.local

# Composer
/vendor/

# Frontend (Angular)
/frontend/node_modules/
/frontend/.angular/
/frontend/dist/

# Runtime user data - never commit private files
/storage/users/*
!/storage/users/.gitkeep

# Misc
/.idea/
/.vs/
/.vscode/
/.phpstan.cache/
/.phpunit.cache/
*.log
Thumbs.db
cookies.txt
