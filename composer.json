{
    "name": "marcinrogut/smartdesk",
    "description": "Smartdesk - prywatny pulpit plików (czysta architektura PHP + Angular)",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Marcin Rogut",
            "email": "marcin.rogut@example.com"
        }
    ],
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.7",
        "php-parallel-lint/php-parallel-lint": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "SmartDesk\\": "src/"
        },
        "files": [
            "src/bootstrap.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "parallel-lint public src",
        "phpstan": "phpstan analyse src/ --level=max",
        "phpcs": "phpcs --standard=.phpcs.xml src/ public/",
        "phpcs-fix": "phpcbf --standard=.phpcs.xml src/ public/",
        "audit": "composer audit",
        "check": [
            "@lint",
            "@phpstan",
            "@phpcs",
            "@audit"
        ]
    },
    "config": {
        "allow-plugins": {
            "php-parallel-lint/php-parallel-lint": true
        },
        "sort-packages": true
    }
}
