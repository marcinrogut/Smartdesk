# Smartdesk — SPA (Angular) w katalogu głównym + API v1

# Angular serwowany na "/" — index.html ma pierwszeństwo
DirectoryIndex index.html

# Bez listowania katalogów
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Endpointy API v1 — obsługiwane bez zmian
    RewriteRule ^api/v1/ - [L]

    # Jawne pliki .php przechodzą bez zmian
    RewriteRule \.php$ - [L]

    # Angular SPA fallback — deep linki obsługuje index.html
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.html [L,QSA]
</IfModule>

# Poprawny typ dla plików JSON
<FilesMatch "\.json$">
    Header set Content-Type "application/json; charset=utf-8"
</FilesMatch>
