# Smartdesk - konfiguracja środowiska (skopiuj do .env i uzupełnij)
#
# Profile środowisk (wzorzec Smartfridge):
#   .env.local - profil DEWELOPERSKI, ma pierwszeństwo i jest ignorowany przez git.
#                Używany, gdy plik istnieje (na produkcji go nie ma).
#   .env       - profil PRODUKCYJNY, wgrywany/utrzymywany na serwerze.
# bootstrap.php ładuje najpierw .env.local, a gdy go nie ma - .env.

# Tryb aplikacji: development | production.
# Wpływa tylko na ujawnianie szczegółów błędów 500 (dev) vs ukrywanie ich (prod).
APP_ENV=production

# Sekret podpisywania tokenów JWT (Bearer). Wymagany. Wygeneruj losowy, długi ciąg.
API_SECRET=change-me-to-a-long-random-string

# Baza danych MySQL / MariaDB (dane profilu PRODUKCYJNEGO - localhost / hosting).
# Profil DEWELOPERSKI ustawia te same zmienne w .env.local (baza LAN).
SMARTDESK_DB_HOST=127.0.0.1
SMARTDESK_DB_NAME=smartdesk
SMARTDESK_DB_USER=smartdesk
SMARTDESK_DB_PASS=
SMARTDESK_DB_CHARSET=utf8mb4

# Opcjonalnie: katalog prywatnych plików użytkowników (domyślnie <root>/storage/users)
# SMARTDESK_STORAGE_PATH=/domains/smartdesk.rogut.net/storage/users

# Opcjonalnie: maksymalny rozmiar przesyłanego pliku w bajtach (domyślnie 25 MB)
# SMARTDESK_MAX_UPLOAD_BYTES=26214400

# Opcjonalnie: lista dozwolonych originów CORS rozdzielona przecinkami.
# Przy deployu same-origin (SPA w webroocie na tej samej domenie) można zostawić puste.
# API_ALLOWED_ORIGINS=https://smartdesk.rogut.net
